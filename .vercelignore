# Only the control plane (api/, models.py, requirements.txt) and the prebuilt
# public/worker-package.zip (built by scripts/build_worker_package.sh, served as a
# static asset) need to be in this deployment. Everything else here is worker-side
# source (runs on provider hardware, never on Vercel) or dev tooling -- see
# SESSION_HANDOFF.md for the control-plane/worker split.
.venv/
gnina-bin/
vina-test/
fixtures/
docs/
scripts/
plain_modules/
python_plain_modules/
conformance_tests/
__pycache__/
*.pyc
docking_marketplace.plain
codeplain.log
jobs.db
escrow_ledger.json
config.yaml
run_unittests_python.sh
run_conformance_tests_python.sh
requirements-worker.txt
requirements-wsl.txt
Dockerfile
docking_worker.py
docking_worker_vina.py
worker_setup.py
worker_daemon.py
engine_entrypoint.py
engine_entrypoint_vina.py
install_worker.sh
SESSION_HANDOFF.md
README.md
# Frontend (its own Vercel project) and Node bridges never run on the Python control plane.
# NOTE: deepbook_log.py IS imported by api/index.py -- do NOT exclude it.
web/
sui-bridge/
deepbook-bridge/
move/
