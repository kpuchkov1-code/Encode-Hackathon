# The control plane (api/, models.py, requirements.txt) is what actually runs on
# Vercel. The worker-side files below are NOT executed here -- they're bundled only so
# GET /download/worker-package.zip can serve them to hardware providers without ever
# giving them git/GitHub access to this repo. See SESSION_HANDOFF.md for the
# control-plane/worker split.
.venv/
gnina-bin/
fixtures/
docs/
scripts/
plain_modules/
python_plain_modules/
conformance_tests/
__pycache__/
*.pyc
docking_marketplace.plain
codeplain.log
jobs.db
escrow_ledger.json
config.yaml
run_unittests_python.sh
run_conformance_tests_python.sh
requirements-wsl.txt
# gnina's engine image/entrypoint aren't offered for download yet (not built/working) --
# exclude them so the download package only contains what actually works (Vina).
Dockerfile
engine_entrypoint.py
SESSION_HANDOFF.md
README.md
